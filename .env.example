# Local development values only. Copy to .env to override the defaults in docker-compose.yml.
POSTGRES_USER=wellbeing
POSTGRES_PASSWORD=wellbeing
POSTGRES_DB=wellbeing
POSTGRES_PORT=5432
# For running Python on the host against the containerized DB:
DATABASE_URL=postgresql+psycopg://wellbeing:wellbeing@localhost:5432/wellbeing
# API (docker compose up -d api)
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
