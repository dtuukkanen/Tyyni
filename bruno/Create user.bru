meta {
  name: Create user
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/users
  body: json
  auth: none
}

body:json {
  {
    "display_name": "demo"
  }
}

script:post-response {
  if (res.status === 201) bru.setVar("userId", res.body.id);
}

assert {
  res.status: eq 201
  res.body.id: isString
}
